# PARALLAX Configuration

# Server Environment
NODE_ENV=development
PORT=3001
VITE_API_URL=http://localhost:3001

# Storage Paths
DATABASE_PATH=./data/parallax.db
SNAPSHOT_STORAGE_PATH=./data/snapshots
ARTIFACT_STORAGE_PATH=./data/artifacts

# LLM Provider Configuration
# Optional: Set provider to 'openai', 'anthropic', 'gemini', or 'demo'
# In 'demo' mode or when no API key is provided, the deterministic rule-based Intent Compiler is used
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=demo-deterministic-v1
LLM_BASE_URL=

# Browser Execution Sandbox & Safety Policy
# Autonomy levels: READ_ONLY_RESEARCH | INTERACTIVE_NAVIGATION | FORM_INTERACTION | HIGH_IMPACT_ACTIONS
DEFAULT_AUTONOMY_LEVEL=INTERACTIVE_NAVIGATION
MAX_CONCURRENT_PAGES=3
PAGE_NAVIGATION_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000

# Security
# Set to 'true' only in local development/testing to allow fixture requests to localhost
ALLOW_LOCAL_FIXTURES=true
SSRF_PROTECTION_ENABLED=true

# Logging
LOG_LEVEL=info
